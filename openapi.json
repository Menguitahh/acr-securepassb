  "components" : {
    "schemas" : {
      "CreateInvitationRequest" : {
        "required" : [
          "guestDocument",
          "guestName",
          "lotId",
          "type",
          "validFrom",
          "validUntil"
        ],
        "type" : "object",
        "properties" : {
          "lotId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string",
            "enum" : [
              "SINGLE",
              "EVENT",
              "RECURRING"
            ]
          },
          "guestName" : {
            "maxLength" : 140,
            "minLength" : 0,
            "type" : "string"
          },
          "guestDocument" : {
            "pattern" : "^[0-9]{7,8}$",
            "type" : "string"
          },
          "companions" : {
            "maximum" : 20,
            "minimum" : 0,
            "type" : "integer",
            "format" : "int32"
          },
          "notes" : {
            "maxLength" : 280,
            "minLength" : 0,
            "type" : "string"
          },
          "validFrom" : {
            "type" : "string",
            "format" : "date-time"
          },
          "validUntil" : {
            "type" : "string",
            "format" : "date-time"
          },
          "weekdays" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "dailyFrom" : {
            "$ref" : "#/components/schemas/LocalTime"
          },
          "dailyUntil" : {
            "$ref" : "#/components/schemas/LocalTime"
          },
          "maxUses" : {
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "LocalTime" : {
        "type" : "object",
        "properties" : {
          "hour" : {
            "type" : "integer",
            "format" : "int32"
          },
          "minute" : {
            "type" : "integer",
            "format" : "int32"
          },
          "second" : {
            "type" : "integer",
            "format" : "int32"
          },
          "nano" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "InvitationResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lotId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "neighborhoodId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "neighborhoodName" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "enum" : [
              "SINGLE",
              "EVENT",
              "RECURRING"
            ]
          },
          "status" : {
            "type" : "string",
            "enum" : [
              "ACTIVE",
              "USED",
              "EXPIRED",
              "REVOKED"
            ]
          },
          "guestName" : {
            "type" : "string"
          },
          "guestDocument" : {
            "type" : "string"
          },
          "companions" : {
            "type" : "integer",
            "format" : "int32"
          },
          "notes" : {
            "type" : "string"
          },
          "validFrom" : {
            "type" : "string",
            "format" : "date-time"
          },
          "validUntil" : {
            "type" : "string",
            "format" : "date-time"
          },
          "weekdays" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int32"
            }
          },
          "dailyFrom" : {
            "$ref" : "#/components/schemas/LocalTime"
          },
          "dailyUntil" : {
            "$ref" : "#/components/schemas/LocalTime"
          },
          "maxUses" : {
            "type" : "integer",
            "format" : "int32"
          },
          "usedCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "qrToken" : {
            "type" : "string"
          },
          "shareUrl" : {
            "type" : "string"
          }
        }
      },
      "AddFamilyMemberRequest" : {
        "required" : [
          "identifier"
        ],
        "type" : "object",
        "properties" : {
          "identifier" : {
            "type" : "string"
          },
          "canInvite" : {
            "type" : "boolean"
          },
          "relation" : {
            "maxLength" : 30,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "FamilyMemberResponse" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "fullName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "phone" : {
            "type" : "string"
          },
          "relation" : {
            "type" : "string"
          },
          "isOwner" : {
            "type" : "boolean"
          },
          "canInvite" : {
            "type" : "boolean"
          },
          "active" : {
            "type" : "boolean"
          }
        }
      },
      "RefreshRequest" : {
        "required" : [
          "refreshToken"
        ],
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string"
          }
        }
      },
      "RefreshResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "LoginRequest" : {
        "required" : [
          "identifier",
          "password"
        ],
        "type" : "object",
        "properties" : {
          "identifier" : {
            "type" : "string"
          },
          "password" : {
            "type" : "string"
          }
        }
      },
      "LoginResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          },
          "user" : {
            "$ref" : "#/components/schemas/UserPayload"
          }
        }
      },
      "LotPayload" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "code" : {
            "type" : "string"
          },
          "canInvite" : {
            "type" : "boolean"
          },
          "isOwner" : {
            "type" : "boolean"
          }
        }
      },
      "UserPayload" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "fullName" : {
            "type" : "string"
          },
          "neighborhoodId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "lots" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LotPayload"
            }
          }
        }
      },
      "CreateLotRequest" : {
        "required" : [
          "code"
        ],
        "type" : "object",
        "properties" : {
          "code" : {
            "maxLength" : 30,
            "minLength" : 0,
            "type" : "string"
          },
          "street" : {
            "maxLength" : 120,
            "minLength" : 0,
            "type" : "string"
