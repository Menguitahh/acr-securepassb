# Copiar a .env y COMPLETAR con valores reales. El archivo .env no se commitea.

# Master key AES-256-GCM para cifrar claves privadas Ed25519 en signing_keys.
# Debe ser exactamente 32 bytes (256 bits) codificados en base64.
# Generar una nueva: openssl rand -base64 32
# El valor de abajo es un placeholder OBVIO solo para desarrollo local.
SECUREPASS_MASTER_KEY=REVWX09OTFlfS0VZXzMyX0JZVEVTX1hYWFhYWFhYWFg=

# Secreto HMAC-SHA256 para JWT de acceso. Minimo 32 bytes.
# Generar: openssl rand -base64 48
SECUREPASS_JWT_SECRET=CHANGE_ME_DEV_ONLY_jwt_secret_at_least_32_bytes_long
SECUREPASS_JWT_TTL_SECONDS=900
SECUREPASS_REFRESH_TTL_DAYS=30

# Postgres. En prod (SPRING_PROFILES_ACTIVE=prod) DB_* y REDIS_HOST son
# obligatorias: sin defaults. Azure exige TLS:
# jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/securepass?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/securepass
DB_USER=securepass
DB_PASSWORD=securepass
# Tope del pool Hikari por replica (default 10).
# DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS (spec 5.5): origenes permitidos, csv. Sin esta variable el default es
# solo el dominio de prod del admin, y el browser bloquea el dashboard local.
# 8081: Metro/Expo web. 3000: dashboard admin (securepassf/web, next dev).
SECUREPASS_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
